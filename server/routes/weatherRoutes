const express = require("express");

const {
  protect,
} = require("../middleware/authMiddleware");

const {
  getCurrentWeather,
  getWeatherForecast,
} = require("../controllers/weatherController");

const router = express.Router();

router.get(
  "/current",
  protect,
  getCurrentWeather
);

router.get(
  "/forecast",
  protect,
  getWeatherForecast
);

module.exports = router;